{
  "name": "dsh-simple-tps",
  "version": "0.1.3",
  "description": "Per-turn TTFT / TPS readout in the DSH web chat action row, next to the built-in usage pill.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets/",
    "screenshots.json"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tps",
    "ttft",
    "metrics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyxiu/dsh-simple-tps.git"
  },
  "homepage": "https://github.com/flyxiu/dsh-simple-tps#readme",
  "bugs": {
    "url": "https://github.com/flyxiu/dsh-simple-tps/issues"
  },
  "scripts": {
    "release": "bash scripts/release.sh",
    "test": "node tests/run.mjs && node tests/host.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
